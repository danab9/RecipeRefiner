# Loaded only by the extension build (`vite build --mode extension`).
# The popup runs on a chrome-extension:// origin, so it must call the API by
# absolute URL. This is the deployed backend; it must match the host in
# extension/public/manifest.json -> host_permissions.
VITE_API_URL=https://reciperefiner.onrender.com/api
# The popup is anonymous: send no session cookie and no CSRF header.
# See src/lib/axios.ts and extension/README.md.
VITE_SEND_CREDENTIALS=false
