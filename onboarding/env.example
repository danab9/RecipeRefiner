# RecipeRefiner — local development environment template.
#
#   Copy this file to `.env` IN THE PROJECT ROOT (not in this folder):
#
#       cp onboarding/env.example .env
#
#   Then fill in the two values marked TODO.
#   Full instructions: onboarding/README.md
#
# `.env` is gitignored. Never commit it. Never send it to anyone.
# This template must only ever contain placeholders — it IS committed.


# --- TODO 1 --------------------------------------------------------------
# Your own random signing key. Generate it — see onboarding/generate-secret-key.md
# Do NOT copy a key from another machine or from Render.
SECRET_KEY=

# --- TODO 2 --------------------------------------------------------------
# Neon connection string for YOUR OWN database branch — see onboarding/README.md, step 4.
# It must NOT be the production branch.
# Looks like: postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=


# --- Leave the rest as-is ------------------------------------------------

# Local only. Never True on a deployed server.
DEBUG=True

# Hostnames Django will answer to locally.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,localhost:8000

# The Vite dev server origin. Port comes from frontend/vite.config.ts (currently 5555).
# If `npm run dev` prints a different port, change it here too or logged-in POSTs will 403.
ALLOWED_ORIGINS=http://localhost:5555,http://127.0.0.1:5555
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5555,http://127.0.0.1:5555
